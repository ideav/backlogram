# Integram EN (ideav.pro): web root = dist-en (static marketing pages) + site-en/engine (PHP engine).
# Existing files and directories are served as is; /start is the auth page; every other path
# goes to the engine (index.php), which treats the first path segment as the workspace name.

DirectoryIndex index.html index.php
DirectorySlash Off
Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host: https and no www. Skipped for local hosts and when the server sets
# INTEGRAM_NO_REDIRECT=1 (SetEnv in the vhost, e.g. in docker-compose).
RewriteCond %{ENV:INTEGRAM_NO_REDIRECT} !^1$
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{ENV:INTEGRAM_NO_REDIRECT} !^1$
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Never expose engine internals: config, includes, SQL seeds, logs, dotfiles.
RewriteRule ^(include|db|logs)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^templates/custom/[^/]+/logs(/|$) - [F,L]
# Uploaded files must never run as code.
RewriteRule ^(download|templates)/.*\.(php\d?|phtml|phar|pht|cgi|pl|sh|asp|jsp)$ - [F,L,NC]

# Legacy document names.
RewriteRule ^offer_en\.html$ /terms [R=301,L]
RewriteRule ^pp_en\.html$ /privacy [R=301,L]

# Auth page.
RewriteRule ^start(\.html)?/?$ start.php [L,QSA]

# Prerendered pages live in <route>/index.html, canonical URLs have no trailing slash:
# /pricing is served from pricing/index.html without a redirect; /pricing/ -> /pricing.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# The home page (DirectoryIndex) and static files as they are.
RewriteRule ^$ index.html [L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else: the engine.
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
