# Integram EN engine configuration. Copy to .env next to index.php (or set real environment
# variables, e.g. SetEnv in the Apache vhost; real env vars win over this file).

# No domain is configured: links in emails, OAuth callbacks, cookies and the default From address
# use the host of the current request (https when HTTPS is on or X-Forwarded-Proto is https).
# Recommended: list the domains this server answers for. A request with any other Host header is
# treated as the first one, so a forged Host never ends up in password-reset links.
#INTEGRAM_ALLOWED_HOSTS=example.com,www.example.com
# Base URL for CLI scripts only (no request to take the host from), no trailing slash
#INTEGRAM_BASE_URL=https://example.com

# MySQL 8 (one database holds the cabinet `my`, the template `en` and every workspace table)
INTEGRAM_DB_HOST=localhost
INTEGRAM_DB_PORT=3306
INTEGRAM_DB_NAME=integram
INTEGRAM_DB_USER=integram
INTEGRAM_DB_PASSWORD=

# Password hashing salt: set once to a long random string and never change it
# (changing it invalidates every password)
INTEGRAM_SALT=
# Optional master password: lets you log in to any workspace as "admin". Empty = disabled.
INTEGRAM_MASTER_PASSWORD=
# Receives new sign-up notifications; empty = none
INTEGRAM_ADMIN_EMAIL=

# Outgoing mail. Port 465: INTEGRAM_SMTP_HOST=ssl://smtp.example.com; port 587: INTEGRAM_SMTP_SECURE=tls.
# Empty password = no SMTP AUTH (local relay).
INTEGRAM_SMTP_HOST=smtp.example.com
INTEGRAM_SMTP_PORT=587
INTEGRAM_SMTP_SECURE=tls
INTEGRAM_SMTP_USERNAME=
INTEGRAM_SMTP_PASSWORD=
# Sender address; empty = no-reply@<current host>
INTEGRAM_SMTP_FROM_EMAIL=
INTEGRAM_SMTP_FROM=Integram

# OAuth apps (callbacks: https://<your-domain>/auth/google and https://<your-domain>/auth/github).
# A provider without keys is hidden on /start.
INTEGRAM_GOOGLE_CLIENT_ID=
INTEGRAM_GOOGLE_CLIENT_SECRET=
INTEGRAM_GITHUB_CLIENT_ID=
INTEGRAM_GITHUB_CLIENT_SECRET=

# Optional Cloudflare Turnstile on sign-up and password reset
INTEGRAM_TURNSTILE_SITEKEY=
INTEGRAM_TURNSTILE_SECRET=

# Bot protection: per-IP limits as max/seconds (defaults shown); INTEGRAM_RATE_LIMIT=0 disables.
#INTEGRAM_RATE_REGISTER=5/3600
#INTEGRAM_RATE_RESET=5/3600
#INTEGRAM_RATE_LOGIN=30/600
#INTEGRAM_RATE_OAUTH=30/600
# Behind Cloudflare/a reverse proxy: trust CF-Connecting-IP / X-Forwarded-For for the client IP
#INTEGRAM_TRUST_PROXY=1

# Workspaces a free-plan user may create in /my (default 3; 0 = unlimited)
#INTEGRAM_MAX_WORKSPACES=3

# Web installer (install.php?token=...); leave empty to allow only `php install.php`
INTEGRAM_INSTALL_TOKEN=
