# mvp.care — статический сайт (сборка site-mvp, issue #872).
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.mvp.care → mvp.care одним 301.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http → https. Только GET/HEAD: POST после редиректа потерял бы тело формы.
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Старая страница Тильды «I d e a V» не переносится.
  RewriteRule ^index1(\.html)?/?$ / [L,R=301]

  # /success и /ideav_callme открываются без слеша и без редиректа.
  RewriteRule ^(success|ideav_callme)/?$ /$1/index.html [L]
</IfModule>

# Конфигурация формы (токены и почта) не раздаётся наружу.
<FilesMatch "^order-config(\.example)?\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
